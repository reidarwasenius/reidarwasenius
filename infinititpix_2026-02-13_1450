<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
  <title>Infinitipix Prototype (Desktop Zoom/Paint Fixes)</title>
  <style>
    :root { --gap: 8px; --sw: 30px; --bg: #111; --panel: rgba(24,24,24,.95); }
    html, body { height: 100%; margin: 0; background: var(--bg); color: #eaeaea; font-family: system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif; }
    header {
      position: fixed; top: 0; left: 0; right: 0; z-index: 10;
      display: grid; grid-template-columns: 1fr; gap: 6px;
      padding: 10px 10px 8px;
      background: var(--panel);
      border-bottom: 1px solid #333;
      backdrop-filter: blur(6px);
    }
    #row1 { display: flex; flex-wrap: wrap; gap: var(--gap); align-items: center; }
    .seg { display: inline-flex; border: 1px solid #444; border-radius: 10px; overflow: hidden; background: #1a1a1a; }
    .seg button { border: 0; padding: 8px 12px; background: transparent; color: #ddd; cursor: pointer; }
    .seg button.active { background: #2a3b66; color: #fff; font-weight: 600; }

    button, input[type="number"], input[type="color"] {
      border: 1px solid #444; background: #1a1a1a; color: #ddd;
      border-radius: 8px; padding: 8px 10px; font-size: 14px;
    }
    button { cursor: pointer; }
    button:hover { background: #212121; }
    label { display: inline-flex; gap: 6px; align-items: center; }
    input[type="number"] { width: 5.5rem; }
    input[type="color"] { padding: 0; width: 44px; height: 36px; }

    #palette {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: var(--sw);
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 4px;
      -webkit-overflow-scrolling: touch;
    }
    .swatch { width: var(--sw); height: var(--sw); border: 1px solid #555; border-radius: 7px; cursor: pointer; box-sizing: border-box; }
    .swatch.selected { outline: 2px solid #fff; outline-offset: 2px; }

    #canvasWrap { position: absolute; left: 0; right: 0; bottom: 0; top: 118px; }
    canvas { width: 100%; height: 100%; display: block; background: #fff; touch-action: none; }

    #hud {
      position: fixed; right: 10px; bottom: 10px;
      background: rgba(0,0,0,.6); color: #ddd;
      padding: 8px 10px; border-radius: 10px; font-size: 12px; max-width: 60vw;
    }
    #hud .muted { color: #bbb; }

    @media (max-width: 520px) {
      :root { --sw: 34px; }
      #canvasWrap { top: 166px; }
    }
  </style>
</head>
<body>
  <header>
    <div id="row1">
      <div class="seg" role="tablist" aria-label="Mode">
        <button id="btnPaint" class="active" aria-selected="true">Paint</button>
        <button id="btnPan" aria-selected="false">Pan</button>
      </div>

      <label>Tile <input id="tileSize" type="number" min="4" max="200" value="40" inputmode="numeric"></label>
      <label>Color <input id="color" type="color" value="#2b7cff"></label>

      <button id="btnZoomIn" title="Zoom in (+)">Zoom +</button>
      <button id="btnZoomOut" title="Zoom out (-)">Zoom −</button>

      <button id="btnOrigin" title="Center on Origin plot (overview zoom)">Origin</button>
      <button id="btnHome" title="Center on Home plot (overview zoom)">Home</button>
      <button id="btnActivity" title="Center on most active plot in most active 10×10 region (pixel mode)">Activity</button>

      <button id="btnExportView" title="Export current view as PNG">Export View</button>
      <button id="btnExport" title="Export painted tiles as JSON">Export</button>
    </div>

    <div id="palette" aria-label="palette"></div>
  </header>

  <div id="canvasWrap"><canvas id="c" tabindex="0"></canvas></div>
  <div id="hud"></div>

<script>
(() => {
  'use strict';

  // ---------------- Constants ----------------
  const PLOT_SIZE = 1000;
  const ORIGIN_PLOT = { x: 1, y: 1 };
  const HOME_PLOT   = { x: 4, y: 4 };
  const DEFAULT_ACTIVITY_FALLBACK = { x: 2, y: 2 };
  const isMobileUA = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  const MAX_PX_PER_TILE = isMobileUA ? 48 : 96;
  const LS_KEY = 'infinitipix-v1';

  // ---------------- DOM ----------------
  const canvas = document.getElementById('c');
  const ctx = canvas.getContext('2d', { alpha: false });
  const hud = document.getElementById('hud');

  const btnPaint = document.getElementById('btnPaint');
  const btnPan   = document.getElementById('btnPan');

  const tileSizeInput = document.getElementById('tileSize');
  const colorInput = document.getElementById('color');

  const btnZoomIn = document.getElementById('btnZoomIn');
  const btnZoomOut = document.getElementById('btnZoomOut');

  const btnOrigin = document.getElementById('btnOrigin');
  const btnHome = document.getElementById('btnHome');
  const btnActivity = document.getElementById('btnActivity');

  const btnExportView = document.getElementById('btnExportView');
  const btnExport = document.getElementById('btnExport');

  const paletteEl = document.getElementById('palette');

  // ---------------- Utilities ----------------
  const DPR = () => Math.max(1, window.devicePixelRatio || 1);
  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
  const key = (tx, ty) => `${tx},${ty}`;
  const plotCoordToGrid = (plotCoord) => plotCoord > 0 ? plotCoord - 1 : plotCoord;
  const gridToPlotCoord = (gridCoord) => gridCoord >= 0 ? gridCoord + 1 : gridCoord;

  function hslToHex(h, s, l){
    s/=100; l/=100;
    const k=n => (n + h/30) % 12;
    const a = s * Math.min(l, 1-l);
    const f=n => l - a * Math.max(-1, Math.min(k(n)-3, Math.min(9-k(n), 1)));
    const toHex=x => Math.round(255*x).toString(16).padStart(2,'0');
    return `#${toHex(f(0))}${toHex(f(8))}${toHex(f(4))}`;
  }
  function buildPalette32(){
    const out = ['#000000','#ffffff','#404040','#808080','#c0c0c0'];
    const remaining = 32 - out.length;
    for (let i=0;i<remaining;i++){
      const h = Math.round((360*i)/remaining);
      out.push(hslToHex(h, 85, 50));
    }
    return out;
  }

  // ---------------- State ----------------
  const tiles = new Map();

  const state = {
    mode: 'paint',
    tileSize: parseInt(tileSizeInput.value, 10) || 40,
    pxPerTile: 16,
    offsetX: 0,
    offsetY: 0,
    pixelMode: false,

    currentColor: colorInput.value,
    selectedSwatch: -1,

    viewW: 0, viewH: 0,

    dragging: false,
    dragStart: {x:0,y:0},
    dragOffsetStart: {x:0,y:0},
    lastPaintKey: null,

    pinchActive: false,
    pinchDist0: 0,
    pinchCenter0: {x:0,y:0},
    pinchPxPerTile0: 0,

    hoverPlot: null,

    // paint feedback (desktop debugging)
    lastPaint: null, // {tx,ty, tMs}
    needsDraw: true,
    saveTimer: null
  };

  // ---------------- Zoom constraints ----------------
  function computeMinPxPerTile(viewW, viewH){
    const landscape = viewW >= viewH;
    const plotsX = landscape ? 6 : 4;
    const plotsY = landscape ? 4 : 6;
    return Math.min(viewW / (plotsX * PLOT_SIZE), viewH / (plotsY * PLOT_SIZE));
  }
  function snapCameraToDevicePixelGrid(){
    const q = 1 / DPR();
    state.offsetX = Math.round(state.offsetX / q) * q;
    state.offsetY = Math.round(state.offsetY / q) * q;
  }
  function clampPxPerTile(){
    if (state.pixelMode){
      state.pxPerTile = 1 / DPR();
      snapCameraToDevicePixelGrid();
      return;
    }
    const minPx = computeMinPxPerTile(state.viewW, state.viewH);
    state.pxPerTile = clamp(state.pxPerTile, minPx, MAX_PX_PER_TILE);
  }
  function setOverviewZoom(){
    state.pixelMode = false;
    state.pxPerTile = computeMinPxPerTile(state.viewW, state.viewH);
    clampPxPerTile();
  }

  // ---------------- Coordinate transforms ----------------
  function worldToScreen(wx, wy){
    return { x: wx*state.pxPerTile + state.offsetX, y: wy*state.pxPerTile + state.offsetY };
  }
  function screenToWorld(sx, sy){
    return { x: (sx - state.offsetX)/state.pxPerTile, y: (sy - state.offsetY)/state.pxPerTile };
  }
  function screenToTile(sx, sy){
    const w = screenToWorld(sx, sy);
    return { tx: Math.floor(w.x), ty: Math.floor(w.y) };
  }

  // ---------------- Camera helpers ----------------
  function centerOnWorld(wx, wy){
    const cx = state.viewW*0.5;
    const cy = state.viewH*0.5;
    state.offsetX = cx - wx*state.pxPerTile;
    state.offsetY = cy - wy*state.pxPerTile;
    if (state.pixelMode) snapCameraToDevicePixelGrid();
    requestDraw();
  }
  function goToPlot(plotX, plotY, forceOverviewZoom){
    if (forceOverviewZoom) setOverviewZoom();
    const gx = plotCoordToGrid(plotX);
    const gy = plotCoordToGrid(plotY);
    const wx = gx*PLOT_SIZE + PLOT_SIZE/2;
    const wy = gy*PLOT_SIZE + PLOT_SIZE/2;
    centerOnWorld(wx, wy);
  }
  function goToHomeFitHeight(){
    state.pixelMode = false;
    state.pxPerTile = state.viewH / PLOT_SIZE;
    goToPlot(HOME_PLOT.x, HOME_PLOT.y, false);
    requestDraw();
    saveDebounced();
  }

  // ---------------- Persistence ----------------
  function saveNow(){
    try {
      const payload = {
        offsetX: state.offsetX, offsetY: state.offsetY,
        pxPerTile: state.pxPerTile, pixelMode: state.pixelMode,
        tileSize: state.tileSize,
        currentColor: state.currentColor,
        selectedSwatch: state.selectedSwatch,
        tiles: Array.from(tiles.entries())
      };
      localStorage.setItem(LS_KEY, JSON.stringify(payload));
    } catch {}
  }
  function saveDebounced(){
    clearTimeout(state.saveTimer);
    state.saveTimer = setTimeout(saveNow, 250);
  }
  function load(){
    try {
      const raw = localStorage.getItem(LS_KEY);
      if (!raw) return false;
      const d = JSON.parse(raw);
      if (typeof d.offsetX === 'number') state.offsetX = d.offsetX;
      if (typeof d.offsetY === 'number') state.offsetY = d.offsetY;
      if (typeof d.pxPerTile === 'number') state.pxPerTile = d.pxPerTile;
      if (typeof d.pixelMode === 'boolean') state.pixelMode = d.pixelMode;
      if (typeof d.tileSize === 'number') state.tileSize = d.tileSize;
      if (typeof d.currentColor === 'string') state.currentColor = d.currentColor;
      if (typeof d.selectedSwatch === 'number') state.selectedSwatch = d.selectedSwatch;
      if (Array.isArray(d.tiles)){
        tiles.clear();
        for (const [k,v] of d.tiles) tiles.set(k,v);
      }
      tileSizeInput.value = String(state.tileSize);
      colorInput.value = state.currentColor;
      return true;
    } catch { return false; }
  }

  // ---------------- Palette UI ----------------
  const PALETTE = buildPalette32();
  function renderPalette(){
    paletteEl.innerHTML = '';
    PALETTE.forEach((c, idx) => {
      const sw = document.createElement('div');
      sw.className = 'swatch' + (idx === state.selectedSwatch ? ' selected' : '');
      sw.style.background = c;
      sw.title = c;
      sw.addEventListener('click', () => {
        state.currentColor = c;
        state.selectedSwatch = idx;
        colorInput.value = c;
        renderPalette();
        saveDebounced();
      }, { passive: true });
      paletteEl.appendChild(sw);
    });
  }

  // ---------------- Mode UI ----------------
  function setMode(mode){
    state.mode = mode;
    btnPaint.classList.toggle('active', mode === 'paint');
    btnPan.classList.toggle('active', mode === 'pan');
    if (mode !== 'pan' && state.hoverPlot){ state.hoverPlot = null; requestDraw(); }
  }
  btnPaint.addEventListener('click', () => setMode('paint'), { passive: true });
  btnPan.addEventListener('click',   () => setMode('pan'),   { passive: true });

  // ---------------- Resize ----------------
  function resize(){
    const rect = canvas.getBoundingClientRect();
    state.viewW = rect.width;
    state.viewH = rect.height;
    const dpr = DPR();
    canvas.width = Math.max(1, Math.floor(rect.width * dpr));
    canvas.height = Math.max(1, Math.floor(rect.height * dpr));
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.imageSmoothingEnabled = !state.pixelMode;
    clampPxPerTile();
    requestDraw();
  }
  window.addEventListener('resize', () => {
    const centerWorld = screenToWorld(state.viewW*0.5, state.viewH*0.5);
    resize();
    centerOnWorld(centerWorld.x, centerWorld.y);
  });

  // ---------------- Painting restriction ----------------
  function isWithinHome(tx, ty){
    const x0 = plotCoordToGrid(HOME_PLOT.x) * PLOT_SIZE;
    const y0 = plotCoordToGrid(HOME_PLOT.y) * PLOT_SIZE;
    return tx >= x0 && tx < x0 + PLOT_SIZE && ty >= y0 && ty < y0 + PLOT_SIZE;
  }
  function paintAtScreen(sx, sy){
    const { tx, ty } = screenToTile(sx, sy);
    if (!isWithinHome(tx, ty)) {
      state.lastPaint = { tx, ty, tMs: performance.now(), blocked: true };
      requestDraw();
      return;
    }
    const k = key(tx, ty);
    if (k === state.lastPaintKey) return;
    tiles.set(k, state.currentColor);
    state.lastPaintKey = k;
    state.lastPaint = { tx, ty, tMs: performance.now(), blocked: false };
    requestDraw();
    saveDebounced();
  }

  // ---------------- Hover plot overlay ----------------
  function updateHoverPlot(clientX, clientY){
    if (state.mode !== 'pan') return;
    const rect = canvas.getBoundingClientRect();
    const sx = clientX - rect.left;
    const sy = clientY - rect.top;
    const { tx, ty } = screenToTile(sx, sy);
    const px = Math.floor(tx / PLOT_SIZE);
    const py = Math.floor(ty / PLOT_SIZE);
    const tl = worldToScreen(px*PLOT_SIZE, py*PLOT_SIZE);
    const w = PLOT_SIZE * state.pxPerTile;
    const same = state.hoverPlot && state.hoverPlot.px === px && state.hoverPlot.py === py;
    state.hoverPlot = { px, py, rect: { x: tl.x, y: tl.y, w, h: w }, label: { x: sx+14, y: sy+14 } };
    if (!same) requestDraw();
  }

  // ---------------- Pointer (mouse/pen) ----------------
  canvas.addEventListener('pointerdown', (e) => {
    canvas.focus({ preventScroll: true });
    canvas.setPointerCapture(e.pointerId);
    state.dragging = true;
    state.dragStart = { x: e.clientX, y: e.clientY };
    state.dragOffsetStart = { x: state.offsetX, y: state.offsetY };
    state.lastPaintKey = null;
    if (state.hoverPlot){ state.hoverPlot = null; requestDraw(); }

    const rect = canvas.getBoundingClientRect();
    const sx = e.clientX - rect.left;
    const sy = e.clientY - rect.top;

    if (state.mode === 'paint') paintAtScreen(sx, sy);
  }, { passive: false });

  canvas.addEventListener('pointermove', (e) => {
    const isDown = (e.buttons & 1) !== 0;

    // hover only when not pressing any button
    if (!isDown && !state.dragging && state.mode === 'pan') updateHoverPlot(e.clientX, e.clientY);

    if (!state.dragging) return;
    if (state.pinchActive) return;

    const rect = canvas.getBoundingClientRect();
    const sx = e.clientX - rect.left;
    const sy = e.clientY - rect.top;

    if (state.mode === 'pan') {
      const dx = e.clientX - state.dragStart.x;
      const dy = e.clientY - state.dragStart.y;
      state.offsetX = state.dragOffsetStart.x + dx;
      state.offsetY = state.dragOffsetStart.y + dy;
      if (state.pixelMode) snapCameraToDevicePixelGrid();
      requestDraw();
      saveDebounced();
    } else {
      if (isDown) paintAtScreen(sx, sy);
    }
  }, { passive: false });

  function endPointer(){
    state.dragging = false;
    state.lastPaintKey = null;
    saveDebounced();
  }
  canvas.addEventListener('pointerup', endPointer, { passive: true });
  canvas.addEventListener('pointercancel', endPointer, { passive: true });
  canvas.addEventListener('pointerleave', () => { if (state.hoverPlot){ state.hoverPlot=null; requestDraw(); } }, { passive: true });

  // ---------------- Touch pinch zoom (mobile) ----------------
  function touchDistance(t0,t1){ return Math.hypot(t0.clientX-t1.clientX, t0.clientY-t1.clientY); }
  function touchCenter(t0,t1){ return { x:(t0.clientX+t1.clientX)/2, y:(t0.clientY+t1.clientY)/2 }; }

  canvas.addEventListener('touchstart', (e) => {
    if (e.touches.length === 2) {
      e.preventDefault();
      state.pinchActive = true;
      state.pinchDist0 = touchDistance(e.touches[0], e.touches[1]);
      state.pinchCenter0 = touchCenter(e.touches[0], e.touches[1]);
      state.pinchPxPerTile0 = state.pxPerTile;
      state.pixelMode = false;
      requestDraw();
    }
  }, { passive: false });

  canvas.addEventListener('touchmove', (e) => {
    if (!state.pinchActive || e.touches.length !== 2) return;
    e.preventDefault();

    const c = touchCenter(e.touches[0], e.touches[1]);
    const d = touchDistance(e.touches[0], e.touches[1]);
    const factor = d / Math.max(1, state.pinchDist0);

    const rect = canvas.getBoundingClientRect();
    const sx = c.x - rect.left;
    const sy = c.y - rect.top;

    const before = screenToWorld(sx, sy);

    state.pxPerTile = state.pinchPxPerTile0 * factor;
    clampPxPerTile();

    const after = screenToWorld(sx, sy);
    state.offsetX += (after.x - before.x) * state.pxPerTile;
    state.offsetY += (after.y - before.y) * state.pxPerTile;

    requestDraw();
    saveDebounced();
  }, { passive: false });

  canvas.addEventListener('touchend', (e) => {
    if (e.touches.length < 2) { state.pinchActive = false; saveDebounced(); }
  }, { passive: true });

  // ---------------- Wheel zoom (desktop) ----------------
  canvas.addEventListener('wheel', (e) => {
    // Important: ctrlKey wheel is used by trackpads for pinch; prevent browser zoom and use it here.
    e.preventDefault();

    // leave pixel mode on manual zoom
    state.pixelMode = false;

    const rect = canvas.getBoundingClientRect();
    const sx = e.clientX - rect.left;
    const sy = e.clientY - rect.top;

    const before = screenToWorld(sx, sy);

    // A slightly stronger factor for trackpads.
    const strength = e.ctrlKey ? 0.0022 : 0.0016;
    const factor = Math.exp((-e.deltaY) * strength);

    state.pxPerTile *= factor;
    clampPxPerTile();

    const after = screenToWorld(sx, sy);
    state.offsetX += (after.x - before.x) * state.pxPerTile;
    state.offsetY += (after.y - before.y) * state.pxPerTile;

    requestDraw();
    saveDebounced();
  }, { passive: false });

  // ---------------- Buttons ----------------
  btnOrigin.addEventListener('click', () => goToPlot(ORIGIN_PLOT.x, ORIGIN_PLOT.y, true), { passive: true });
  btnHome.addEventListener('click', goToHomeFitHeight, { passive: true });

  btnActivity.addEventListener('click', async () => {
    const target = await fetchHotRegionAndPlot().catch(() => null) || DEFAULT_ACTIVITY_FALLBACK;
    state.pixelMode = true;
    clampPxPerTile();
    goToPlot(target.x, target.y, false);
    ctx.imageSmoothingEnabled = false;
    saveDebounced();
  }, { passive: true });

  function zoomAboutCenter(mult){
    state.pixelMode = false;
    const cx = state.viewW*0.5, cy = state.viewH*0.5;
    const before = screenToWorld(cx, cy);
    state.pxPerTile *= mult;
    clampPxPerTile();
    const after = screenToWorld(cx, cy);
    state.offsetX += (after.x - before.x) * state.pxPerTile;
    state.offsetY += (after.y - before.y) * state.pxPerTile;
    requestDraw();
    saveDebounced();
  }
  btnZoomIn.addEventListener('click', () => zoomAboutCenter(1.25), { passive: true });
  btnZoomOut.addEventListener('click', () => zoomAboutCenter(1/1.25), { passive: true });

  btnExport.addEventListener('click', () => {
    const payload = { tiles: Array.from(tiles.entries()), meta: { homePlot: HOME_PLOT, plotSize: PLOT_SIZE } };
    const blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'tiles.json'; a.click();
    URL.revokeObjectURL(url);
  }, { passive: true });

  btnExportView.addEventListener('click', () => {
    const dpr = DPR();
    const w = Math.max(1, Math.floor(state.viewW * dpr));
    const h = Math.max(1, Math.floor(state.viewH * dpr));
    const tmp = document.createElement('canvas');
    tmp.width = w; tmp.height = h;
    const tctx = tmp.getContext('2d', { alpha: false });
    tctx.setTransform(dpr,0,0,dpr,0,0);
    tctx.drawImage(canvas, 0, 0, state.viewW, state.viewH);
    tmp.toBlob((blob) => {
      if (!blob) return;
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = 'view.png'; a.click();
      URL.revokeObjectURL(url);
    }, 'image/png');
  }, { passive: true });

  // ---------------- Inputs ----------------
  tileSizeInput.addEventListener('change', () => {
    const v = parseInt(tileSizeInput.value, 10);
    if (!Number.isFinite(v) || v < 4) return;
    state.tileSize = v;
    clampPxPerTile();
    requestDraw();
    saveDebounced();
  }, { passive: true });

  colorInput.addEventListener('input', () => {
    state.currentColor = colorInput.value;
    state.selectedSwatch = -1;
    renderPalette();
    saveDebounced();
  }, { passive: true });

  // ---------------- Keyboard shortcuts ----------------
  window.addEventListener('keydown', (e) => {
    if (e.target && (e.target.tagName === 'INPUT')) return;
    if (e.key === '+' || e.key === '=') zoomAboutCenter(1.25);
    else if (e.key === '-' || e.key === '_') zoomAboutCenter(1/1.25);
    else if (e.key.toLowerCase() === 'h') goToHomeFitHeight();
    else if (e.key.toLowerCase() === 'o') goToPlot(ORIGIN_PLOT.x, ORIGIN_PLOT.y, true);
    else if (e.key.toLowerCase() === 'a') btnActivity.click();
  });

  // ---------------- Activity heuristic ----------------
  function median(arr){
    if (!arr.length) return 0;
    const s = arr.slice().sort((a,b)=>a-b);
    const m = Math.floor(s.length/2);
    return (s.length % 2) ? s[m] : 0.5*(s[m-1]+s[m]);
  }

  async function fetchHotRegionAndPlot(){
    if (tiles.size === 0) return { x: DEFAULT_ACTIVITY_FALLBACK.x, y: DEFAULT_ACTIVITY_FALLBACK.y };

    const plotCounts = new Map(); // "px,py" -> count
    for (const k of tiles.keys()){
      const [txs, tys] = k.split(',');
      const tx = +txs, ty = +tys;
      const px = Math.floor(tx / PLOT_SIZE);
      const py = Math.floor(ty / PLOT_SIZE);
      const pk = `${px},${py}`;
      plotCounts.set(pk, (plotCounts.get(pk) || 0) + 1);
    }

    const region = new Map(); // "rx,ry" -> {vals, plots}
    for (const [pk, c] of plotCounts){
      const [pxs, pys] = pk.split(',');
      const px = +pxs, py = +pys;
      const rx = Math.floor(px / 10);
      const ry = Math.floor(py / 10);
      const rk = `${rx},${ry}`;
      const rec = region.get(rk) || { vals: [], plots: [] };
      rec.vals.push(c);
      rec.plots.push({ px, py, c });
      region.set(rk, rec);
    }

    let best = null, bestScore = -Infinity;
    for (const rec of region.values()){
      const score = median(rec.vals);
      if (score > bestScore){ bestScore = score; best = rec; }
    }
    if (!best || best.plots.length === 0) return { x: DEFAULT_ACTIVITY_FALLBACK.x, y: DEFAULT_ACTIVITY_FALLBACK.y };

    best.plots.sort((a,b)=>b.c-a.c);
    return { x: gridToPlotCoord(best.plots[0].px), y: gridToPlotCoord(best.plots[0].py) };
  }

  // ---------------- Rendering ----------------
  function requestDraw(){ state.needsDraw = true; }

  function draw(){
    state.needsDraw = false;
    ctx.imageSmoothingEnabled = !state.pixelMode;

    // background
    ctx.clearRect(0,0,state.viewW,state.viewH);
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0,0,state.viewW,state.viewH);

    drawGuides();
    drawPaintedTiles();
    drawHomeOutline();
    drawOriginMarker();
    drawHoverOverlay();
    drawPaintFeedback();

    const lp = state.lastPaint ? `lastPaint tile=(${state.lastPaint.tx},${state.lastPaint.ty}) ${state.lastPaint.blocked?'BLOCKED':'OK'}` : 'lastPaint -';
    hud.innerHTML =
      `mode=${state.mode} &nbsp; px/tile=${state.pxPerTile.toFixed(4)} &nbsp; tiles=${tiles.size} &nbsp; dpr=${DPR().toFixed(2)}<br>` +
      `<span class="muted">Zoom: mouse wheel or trackpad pinch (Ctrl-wheel), or Zoom +/- buttons. ${lp}</span>`;
  }

  function drawPaintedTiles(){
    const tx0 = Math.floor((-state.offsetX)/state.pxPerTile) - 1;
    const ty0 = Math.floor((-state.offsetY)/state.pxPerTile) - 1;
    const tx1 = Math.ceil((state.viewW - state.offsetX)/state.pxPerTile) + 1;
    const ty1 = Math.ceil((state.viewH - state.offsetY)/state.pxPerTile) + 1;

    const size = Math.max(1, Math.ceil(state.pxPerTile));
    for (const [k, col] of tiles){
      const [txs, tys] = k.split(',');
      const tx = +txs, ty = +tys;
      if (tx < tx0 || tx > tx1 || ty < ty0 || ty > ty1) continue;
      const sx = Math.floor(tx*state.pxPerTile + state.offsetX);
      const sy = Math.floor(ty*state.pxPerTile + state.offsetY);
      ctx.fillStyle = col;
      ctx.fillRect(sx, sy, size, size);
    }
  }

  function drawGuides(){
    const minX = Math.floor((-state.offsetX)/state.pxPerTile);
    const minY = Math.floor((-state.offsetY)/state.pxPerTile);
    const maxX = Math.ceil((state.viewW - state.offsetX)/state.pxPerTile);
    const maxY = Math.ceil((state.viewH - state.offsetY)/state.pxPerTile);

    const startTX = Math.floor(minX / PLOT_SIZE) * PLOT_SIZE;
    const startTY = Math.floor(minY / PLOT_SIZE) * PLOT_SIZE;

    ctx.lineWidth = 1;

    ctx.strokeStyle = 'rgba(80,160,255,0.9)';
    ctx.beginPath();
    for (let tx = startTX; tx <= maxX; tx += PLOT_SIZE){
      const x = Math.round(tx*state.pxPerTile + state.offsetX) + 0.5;
      ctx.moveTo(x, 0);
      ctx.lineTo(x, state.viewH);
    }
    ctx.stroke();

    ctx.strokeStyle = 'rgba(255,80,80,0.9)';
    ctx.beginPath();
    for (let ty = startTY; ty <= maxY; ty += PLOT_SIZE){
      const y = Math.round(ty*state.pxPerTile + state.offsetY) + 0.5;
      ctx.moveTo(0, y);
      ctx.lineTo(state.viewW, y);
    }
    ctx.stroke();
  }

  function drawHomeOutline(){
    const x0 = plotCoordToGrid(HOME_PLOT.x)*PLOT_SIZE;
    const y0 = plotCoordToGrid(HOME_PLOT.y)*PLOT_SIZE;
    const tl = worldToScreen(x0, y0);
    const w = PLOT_SIZE * state.pxPerTile;

    ctx.save();
    ctx.strokeStyle = 'rgba(0,0,0,0.35)';
    ctx.lineWidth = 2;
    ctx.setLineDash([8, 6]);
    ctx.strokeRect(Math.round(tl.x)+0.5, Math.round(tl.y)+0.5, Math.round(w), Math.round(w));
    ctx.restore();
  }

  function drawOriginMarker(){
    const o = worldToScreen(0,0);
    ctx.save();
    ctx.font = 'bold 28px system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.lineWidth = 4;
    ctx.strokeStyle = 'rgba(255,255,255,0.85)';
    ctx.fillStyle = '#000';
    ctx.strokeText('O', Math.round(o.x), Math.round(o.y));
    ctx.fillText('O', Math.round(o.x), Math.round(o.y));
    ctx.restore();
  }

  function roundRect(x,y,w,h,r){
    const rr = Math.min(r, w/2, h/2);
    ctx.beginPath();
    ctx.moveTo(x+rr, y);
    ctx.arcTo(x+w, y,   x+w, y+h, rr);
    ctx.arcTo(x+w, y+h, x,   y+h, rr);
    ctx.arcTo(x,   y+h, x,   y,   rr);
    ctx.arcTo(x,   y,   x+w, y,   rr);
    ctx.closePath();
  }

  function drawHoverOverlay(){
    if (state.mode !== 'pan' || !state.hoverPlot) return;
    const hp = state.hoverPlot;

    ctx.save();
    ctx.strokeStyle = 'rgba(0,0,0,0.65)';
    ctx.lineWidth = 2;
    ctx.setLineDash([6,4]);
    ctx.strokeRect(
      Math.round(hp.rect.x)+0.5,
      Math.round(hp.rect.y)+0.5,
      Math.round(hp.rect.w),
      Math.round(hp.rect.h)
    );

    const label = `Plot (${gridToPlotCoord(hp.px)}, ${gridToPlotCoord(hp.py)})`;
    ctx.font = '12px system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif';
    const pad = 6;
    const tw = Math.ceil(ctx.measureText(label).width);
    const bw = tw + pad*2, bh = 22;

    ctx.fillStyle = 'rgba(0,0,0,0.65)';
    roundRect(hp.label.x, hp.label.y, bw, bh, 7);
    ctx.fill();
    ctx.fillStyle = '#fff';
    ctx.textBaseline = 'middle';
    ctx.fillText(label, hp.label.x + pad, hp.label.y + bh/2);
    ctx.restore();
  }

  function drawPaintFeedback(){
    const lp = state.lastPaint;
    if (!lp) return;
    const age = performance.now() - lp.tMs;
    if (age > 700) return; // show briefly

    const s = worldToScreen(lp.tx, lp.ty);
    const size = Math.max(6, Math.ceil(state.pxPerTile) + 6); // purely visual highlight; does not change tile size
    ctx.save();
    ctx.strokeStyle = lp.blocked ? 'rgba(255,0,0,0.9)' : 'rgba(0,200,0,0.9)';
    ctx.lineWidth = 2;
    ctx.setLineDash([4,3]);
    ctx.strokeRect(Math.round(s.x - 3)+0.5, Math.round(s.y - 3)+0.5, size, size);
    ctx.restore();
  }

  // ---------------- Zoom buttons and Origin/Home/Activity ----------------
  btnOrigin.addEventListener('click', () => goToPlot(ORIGIN_PLOT.x, ORIGIN_PLOT.y, true), { passive: true });
  btnHome.addEventListener('click', goToHomeFitHeight, { passive: true });

  btnActivity.addEventListener('click', async () => {
    const t = await fetchHotRegionAndPlot().catch(() => null) || DEFAULT_ACTIVITY_FALLBACK;
    state.pixelMode = true;
    clampPxPerTile();
    goToPlot(t.x, t.y, false);
    requestDraw();
    saveDebounced();
  }, { passive: true });

  // ---------------- Export ----------------
  btnExport.addEventListener('click', () => {
    const payload = { tiles: Array.from(tiles.entries()), meta: { homePlot: HOME_PLOT, plotSize: PLOT_SIZE } };
    const blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'tiles.json'; a.click();
    URL.revokeObjectURL(url);
  }, { passive: true });

  btnExportView.addEventListener('click', () => {
    const dpr = DPR();
    const w = Math.max(1, Math.floor(state.viewW * dpr));
    const h = Math.max(1, Math.floor(state.viewH * dpr));
    const tmp = document.createElement('canvas');
    tmp.width = w; tmp.height = h;
    const tctx = tmp.getContext('2d', { alpha: false });
    tctx.setTransform(dpr,0,0,dpr,0,0);
    tctx.drawImage(canvas, 0, 0, state.viewW, state.viewH);
    tmp.toBlob((blob) => {
      if (!blob) return;
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = 'view.png'; a.click();
      URL.revokeObjectURL(url);
    }, 'image/png');
  }, 'image/png');

  // ---------------- Tile size + color ----------------
  tileSizeInput.addEventListener('change', () => {
    const v = parseInt(tileSizeInput.value, 10);
    if (!Number.isFinite(v) || v < 4) return;
    state.tileSize = v;
    clampPxPerTile();
    requestDraw();
    saveDebounced();
  }, { passive: true });

  colorInput.addEventListener('input', () => {
    state.currentColor = colorInput.value;
    state.selectedSwatch = -1;
    renderPalette();
    saveDebounced();
  }, { passive: true });

  // ---------------- Self-tests ----------------
  function runSelfTests(){
    console.assert(typeof requestDraw === 'function', 'requestDraw missing');
    const expected = 1 / DPR();
    state.pixelMode = true; clampPxPerTile();
    console.assert(Math.abs(state.pxPerTile - expected) < 1e-9, 'pixel mode pxPerTile != 1/DPR');
    state.pixelMode = false;
    console.log('[SelfTest] ok');
  }

  // ---------------- Init ----------------
  renderPalette();
  setMode('paint');

  const had = load();
  resize();

  if (!had) {
    setOverviewZoom();
    goToPlot(HOME_PLOT.x, HOME_PLOT.y, true);
  } else {
    clampPxPerTile();
    requestDraw();
  }

  runSelfTests();

  // RAF loop
  function frame(){
    if (state.needsDraw) draw();
    requestAnimationFrame(frame);
  }
  frame();

})();
</script>
</body>
</html>
